 "question", "contents": [{"content": "engenn9le09ob10re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Tell me about your career plan!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn9le09ob10re2aud01", "coverimg": "engenn9le09ob10re2img01.jpg", "images": [{"image": "engenn9le09ob10re2img01.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn9le09ob10re2img01.jpg", "text": "<span class=\"strong\">Announcer</span>: Hello and welcome to \u201cPractical Advice\u201d, the show that gives you substantial advice about everything. Today we are going to dive into job hunting. By the end of the program, you will have heard about job hunting techniques for later on in life and you will have heard from my guest, job hunting expert Rita MacNeil. Rita welcome.<br/><span class=\"strong\">Rita</span>: Thanks for having me.\n<br/><span class=\"strong\">Announcer</span>: If we had met before, we would have had you on sooner. You will be starting your own podcast next month called \u201cYour Personal Best\u201d.   Is that right?\n<br/><span class=\"strong\">Rita</span>: Actually, it's called \"The Best of You\u201d. If you had listened to it, you would have known that.", "time": "100", "id": 1}, {"image": "engenn9le09ob10re2img02.jpg", "text": "<span class=\"strong\">Announcer</span>: Right. Now, Rita, you will be releasing your fourth book on this subject?\n<br/><span class=\"strong\">Rita</span>: No, this is my third.\n<br/><span class=\"strong\">Announcer</span>: Right.  It's a very far-reaching topic. People will have changed their jobs several times in their lifetime.\n<br/><span class=\"strong\">Rita</span>: Yes, the focus in the job market is more on temporary contract positions than on full-time jobs.\n<br/><span class=\"strong\">Announcer</span>: Right, you also write about age discrimination in the workplace.\n<br/><span class=\"strong\">Rita</span>: Yes, my studies have disclosed that older individuals tend to spend twice as much time looking for jobs than younger people do.", "time": "35800", "id": 2}, {"image": "engenn9le09ob10re2img03.jpg", "text": "<span class=\"strong\">Announcer</span>: Are there many obstacles facing job hunters?\n<br/><span class=\"strong\">Rita</span>: Oh yes, not only discrimination, but having to acclimatize to the new technology. Me personally, if I had taken more computer courses in college, I would have been better off than I am now.\n<br/><span class=\"strong\">Announcer</span>: You would have also been better off if you had listened to your kids when they explained Facebook.\n<br/><span class=\"strong\">Rita</span>: Perhaps.\n<br/><span class=\"strong\">Announcer</span>: We will be coming back after these messages.", "time": "65000", "id": 3}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "type": "sena"}