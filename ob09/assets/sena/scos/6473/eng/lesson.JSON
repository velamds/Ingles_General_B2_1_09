: "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "\n\nInstructions: Move the words up or down <span class=\"sena-icon sena-icon-vertical-drag\"></span> to complete each sentence\n.", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}], "type": "MT1", "template_override": 1}, {"id": 10, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn9le09ob09re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " If you could give advice to your younger self, what would you say?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn9le09ob09re2img01.jpg"}, {"text": "Yesterday was a tough day. First, in the morning, I scoped out the Corbin group and talked to an employee there named Roger, who I actually knew.  He gave me some good insight into the organization. It sounds like an interesting place.\n<br/>\nIf only I had gotten his card the first time we met, yesterday's meeting wouldn't have been so awkward.  If I'd had his card, I could have called beforehand and not seemed quite so desperate. Oh well.", "id": 1, "time": "100", "image": "engenn9le09ob09re2img01.jpg"}, {"text": "In the afternoon, I had planned to contact Durban Inc. I talked about them previously, didn't I? Anyway, while I was at Corbin, a friend sent me an e-mail saying that Durbin had a job opening that I would be perfect for, but I needed to contact them immediately. I was so excited, but my excitement quickly turned to frustration; the position had already been filled ... that morning.\n<br/>\nI remember badgering the HR director with questions on the phone. \u201cThe position is still open, isn't it? If I send my r\u00e9sum\u00e9 now I can still be considered, can't I?  You aren't looking for anyone else, are you?\u201d It was humiliating.", "id": 2, "time": "28000", "image": "engenn9le09ob09re2img02.jpg"}, {"text": "If only I had stayed home that morning, I would have gotten the e-mail earlier.<br/>\nIf only I had talked to my source earlier in the week, I would have had a chance to apply. If only I hadn't gone to the Corbin group in the morning, I would have had a chance at this opportunity. Sometimes in life you make choices without even knowing it.", "id": 3, "time": "68400", "image": "engenn9le09ob09re2img03.jpg"}], "audiosrc": "engenn9le09ob09re2aud01", "coverimg": "engenn9le09ob09re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}